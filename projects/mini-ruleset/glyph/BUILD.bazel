load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "providers_bzl",
    srcs = ["providers.bzl"],
)

bzl_library(
    name = "macros_bzl",
    srcs = ["macros.bzl"],
    deps = [
        ":providers_bzl",
        "//glyph/internal:rules_bzl",
    ],
)

# The public API surface Stardoc documents. deps cover the full transitive load
# graph of defs.bzl.
bzl_library(
    name = "defs_bzl",
    srcs = ["defs.bzl"],
    deps = [
        ":macros_bzl",
        ":providers_bzl",
        "//glyph/internal:rules_bzl",
        "//glyph/transitions:transitions_bzl",
    ],
)
