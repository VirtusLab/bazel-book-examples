module(
    name = "maintainer-workspace",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_java", version = "9.0.3")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "llvm", version = "0.8.11")

llvm_toolchain = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
llvm_toolchain.exec(
    arch = "x86_64",
    os = "linux",
)
llvm_toolchain.exec(
    arch = "aarch64",
    os = "linux",
)
llvm_toolchain.exec(
    arch = "x86_64",
    os = "macos",
)
llvm_toolchain.exec(
    arch = "aarch64",
    os = "macos",
)
llvm_toolchain.target(
    arch = "x86_64",
    os = "linux",
)
llvm_toolchain.target(
    arch = "aarch64",
    os = "linux",
)
llvm_toolchain.target(
    arch = "x86_64",
    os = "macos",
)
llvm_toolchain.target(
    arch = "aarch64",
    os = "macos",
)
use_repo(llvm_toolchain, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")

policy = use_extension("//tools:policy_extension.bzl", "policy_extension")
policy.release(channel = "stable")
use_repo(policy, "release_policy")
